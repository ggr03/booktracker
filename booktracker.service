[Unit]
Description=Book Tracker local web app
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/booktracker_app
ExecStart=%h/booktracker_app/venv/bin/python %h/booktracker_app/app.py serve --host 0.0.0.0 --port 7077
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
